{
  "name": "fontpool",
  "version": "1.4.0",
  "description": "MCP server that searches Fontshare, Fontsource and Google as one catalog with categories, tags and foundry descriptions, downloads real woff2 files into your project and writes the @font-face rules.",
  "type": "module",
  "license": "MIT",
  "author": "Travis Valeri",
  "mcpName": "io.github.travisvaleri/fontpool",
  "homepage": "https://github.com/travisvaleri/fontpool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travisvaleri/fontpool.git"
  },
  "bugs": {
    "url": "https://github.com/travisvaleri/fontpool/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "fonts",
    "typography",
    "webfonts",
    "font-face",
    "woff2",
    "fontshare",
    "fontsource",
    "google-fonts",
    "unifont",
    "self-hosted",
    "claude",
    "skill",
    "type-design"
  ],
  "bin": {
    "fontpool": "server.mjs"
  },
  "files": [
    "server.mjs",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "unifont": "^0.8.3",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
